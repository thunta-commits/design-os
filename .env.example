# Copy to .env.local for `npm run dev`. In production set these in Vercel → Project → Settings → Environment Variables.

# Login (required)
APP_PASSWORD=
SESSION_SECRET=            # long random string, e.g. `openssl rand -base64 32`

# Linear (priority 1)
LINEAR_API_KEY=            # personal API key from Linear → Settings → Security & access
LINEAR_VIEWER_EMAIL=thunta@luminpdf.com
LINEAR_WORKSPACE_SLUG=     # optional, defaults to the key's organization (luminpdf)
LINEAR_TEAM_KEY=           # optional, team whose active cycle is shown (AG or EXP); defaults to the team with most open issues

# Figma (next slice)
FIGMA_TOKEN=
FIGMA_TEAM_ID=1014494708155772450
FIGMA_PROJECT_ID=673533984

# Database (Neon via Vercel, persistence slice)
DATABASE_URL=

# Dev only: show the prototype's sample Linear + Figma data
VITE_SAMPLE_DATA=
